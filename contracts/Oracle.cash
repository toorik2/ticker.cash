pragma cashscript >= 0.14.0;

// Oracle v25 draft — notarized, slotless, one transaction per update.
//
// Constructor (fixed for the life of the deployment; D1 = no rotation path):
//   table       13 × (pubkey 33 ‖ source 1) = 442 B — the notary set, row order (D11).
//   tickerLock  the 31-B P2S Ticker locking bytecode.
//
// Head commit (12 B, identical to the Ticker commit): seq(4, u32 LE) ‖ price(8, u64 LE)
//   seq = Unix minute (floor(unix_time / 60)) in which the notaries observed. Strictly increasing.
//   u32 minutes run to the year 6053 before the sign bit; u64 price covers $184 billion per BCH.
//
// Statement signed by notary row r (Schnorr data signature; the message is never stored):
//   0x4e ‖ category(32, VM byte order) ‖ r(1) ‖ source(1) ‖ seq(4) ‖ price(8)      (47 B)
//   source is read from the table entry, so a notary signs the exchange its row is pinned to.
//
// The Oracle reads no foreign inputs: only its own input and its own outputs.
contract Oracle(bytes table, bytes tickerLock) {
    function update(
        bytes seq,        // 4 B u32 LE Unix minute, strictly increasing
        bytes rows,       // k × 1 B row indexes, strictly ascending
        bytes prices,     // k × 8 B observation per row, same order
        bytes sigs,       // k × 64 B Schnorr data signatures, same order
        bytes median      // 8 B claimed lower median (a 1-B index costs +16 B of redeem for -8 B of unlocking: measured, rejected)
    ) {
        int idx = this.activeInputIndex;
        bytes old = tx.inputs[idx].nftCommitment;
        require(seq.length == 4);
        require(int(seq) > int(old.slice(0, 4)));

        int k = rows.length;
        require(k >= 7);
        require(prices.length == k * 8);
        require(sigs.length == k * 64);
        require(median.length == 8);

        bytes cat = tx.inputs[idx].tokenCategory.slice(0, 32);
        bytes prefix = 0x4e + cat;
        int med = int(median);
        int lower = 0;
        int upper = 0;
        bool found = false;
        int prev = -1;
        int i = 0;
        do {
            bytes row = rows.slice(i, i + 1);
            int r = int(row);
            require(r > prev);
            prev = r;
            bytes price = prices.slice(i * 8, i * 8 + 8);
            int p = int(price);
            if (p < med) { lower = lower + 1; }
            else { if (p > med) { upper = upper + 1; } else { found = true; } }
            bytes entry = table.slice(r * 34, r * 34 + 34);
            pubkey npk = pubkey(entry.slice(0, 33));
            datasig s = datasig(sigs.slice(i * 64, i * 64 + 64));
            require(checkDataSig(s, prefix + row + entry.slice(33, 34) + seq + price, npk));
            i = i + 1;
        } while (i < k);
        require(found);
        require(lower <= (k - 1) / 2);
        require(upper <= k / 2);

        // exactly: head′ + K = 2 tickers; 708 sats is the dust floor of an 88-byte P2S token output
        bytes commit = seq + median;
        require(tx.outputs.length == 3);
        require(tx.outputs[0].lockingBytecode == tx.inputs[idx].lockingBytecode);
        require(tx.outputs[0].tokenCategory == tx.inputs[idx].tokenCategory);
        require(tx.outputs[0].nftCommitment == commit);
        require(tx.outputs[0].tokenAmount == 0);
        int j = 1;
        do {
            require(tx.outputs[j].lockingBytecode == tickerLock);
            require(tx.outputs[j].tokenCategory == cat);
            require(tx.outputs[j].nftCommitment == commit);
            require(tx.outputs[j].tokenAmount == 0);
            require(tx.outputs[j].value == 708);
            j = j + 1;
        } while (j < 3);

        // fee/dust reserve: the head pays for its own updates. Builders pay exactly size + 1 sats;
        // 5000 is a ceiling that tolerates a fee rate of ~1.7 sat/B at k = 13 before a re-genesis is needed.
        require(tx.outputs[0].value >= tx.inputs[idx].value - 5000);
    }
}
