pragma cashscript >= 0.14.0;

// Ticker v25 draft — immutable NFT (category = Oracle), commit = seq(4) ‖ price(8). P2S (31 B). Value pinned by the Oracle at the 708-sat dust floor.
// consume(): re-emit at the same index (chain of consumers, co-final with the update).
// sweep():   anyone may reclaim the dust once the ticker is >= 144 units old
//            (legacy relative-lock units: 600 ticks each = 1 day before and after Faster Blocks).
contract Ticker() {
    function consume() {
        int idx = this.activeInputIndex;
        require(tx.outputs[idx].lockingBytecode == tx.inputs[idx].lockingBytecode);
        require(tx.outputs[idx].tokenCategory == tx.inputs[idx].tokenCategory);
        require(tx.outputs[idx].value == tx.inputs[idx].value);
    }
    function sweep() {
        require(this.age >= 144);
    }
}
