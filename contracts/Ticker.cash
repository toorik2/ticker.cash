pragma cashscript >= 0.14.0;

// Ticker v27 — an immutable NFT of the oracle's category carrying the 17-byte snapshot
//   timestamp(4) ‖ messageSequence(4) ‖ dataSequence(4) ‖ price(4, US cents) ‖ k(1)
// The first 16 bytes are a General Protocols price-oracle message (little-endian signed ints):
// the timestamp is the start of the observed minute, both sequences are the oracle's contiguous
// update counter, the price is the lower median in cents. k is the number of rows that signed.
// Minted two per update by the Oracle at the exact dust floor; P2S, so this lock is the output.
//
// consume(): a consumer co-spends the Ticker and recreates it at the same index with the same
//            lock, category and commitment, adding a 1,000-sat toll. The toll stays in the Ticker
//            and reaches the oracle's reserve when the Ticker is recycled.
// recycle(): only inside a transaction whose input 0 is this category's minting head, and only a
//            day after the Ticker's own timestamp by chain time (median-time-past, a time-mode
//            locktime). The NFT is burned by not being re-emitted; the Oracle's value rule
//            carries its sats into the reserve.
contract Ticker() {
    function consume() {
        int idx = this.activeInputIndex;
        require(tx.outputs[idx].lockingBytecode == tx.inputs[idx].lockingBytecode);
        require(tx.outputs[idx].tokenCategory == tx.inputs[idx].tokenCategory);
        require(tx.outputs[idx].nftCommitment == tx.inputs[idx].nftCommitment);
        require(tx.outputs[idx].value >= tx.inputs[idx].value + 1000);
    }
    function recycle() {
        int idx = this.activeInputIndex;
        require(tx.inputs[0].tokenCategory == tx.inputs[idx].tokenCategory + 0x02);
        require(tx.time >= int(tx.inputs[idx].nftCommitment.split(4)[0]) + 86400);
    }
}
