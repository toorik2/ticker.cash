pragma cashscript >= 0.14.0;

// PriceGated v27 — reference consumer. Releases to `recipient` once a co-spent Ticker (input 1,
// recreated at output 1 with its toll by Ticker.consume) shows price >= strike, a timestamp
// inside [minTime, maxTime], and at least minK rows behind it.
//
// Only the category is pinned: the head is the category's only minting NFT and the Oracle mints
// every other token of it, so any immutable NFT of the category with a 17-byte commitment is a
// Ticker. The head itself has a 37-byte commitment and a 33-byte tokenCategory (capability byte),
// so it cannot pass as one.
//
//   strike   US cents per BCH, 4 bytes little-endian (General Protocols units)
//   minTime  freshness floor (Unix seconds; a Ticker's timestamp is the start of its minute)
//   maxTime  ceiling against a hoarded Ticker surfacing after the market moved
//   minK     rows that must have signed: 7 is the oracle's floor (4 keys to forge), 11 is six
//            keys, 13 is seven. Choose from what the money at stake deserves.
contract PriceGated(
    pubkey  recipient,
    bytes4  strike,
    bytes32 oracleCategoryVm,   // 32 B category in VM byte order
    int     minTime,
    int     maxTime,
    int     minK
) {
    function release(sig s) {
        require(this.activeInputIndex == 0);
        require(tx.inputs[1].tokenCategory == oracleCategoryVm);
        bytes c = tx.inputs[1].nftCommitment;
        require(c.length == 17);
        int t = int(c.slice(0, 4));
        require(t >= minTime);
        require(t <= maxTime);
        require(int(c.slice(12, 16)) >= int(strike));
        require(int(c.slice(16, 17)) >= minK);
        require(checkSig(s, recipient));
    }
}
